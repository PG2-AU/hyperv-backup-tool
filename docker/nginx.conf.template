server {
    listen 8443 ssl default_server;
    server_name _;

    ssl_certificate     ${HVNB_TLS_CERT_PATH};
    ssl_certificate_key ${HVNB_TLS_KEY_PATH};
    ssl_protocols       TLSv1.2 TLSv1.3;

    root ${FRONTEND_DIST};
    index index.html;

    location /api/ {
        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Discovery-Endpunkte (NetApp/Hyper-V) koennen bei mehreren Clustern/
        # Knoten laenger als die nginx-Standardwerte (60s) dauern; ohne diese
        # Erhoehung liefert nginx sonst ein generisches 504-Gateway-Timeout
        # (HTML statt JSON), was im Frontend wie ein Absturz ohne
        # Fehlermeldung wirkt.
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }

    location / {
        try_files $uri /index.html;
    }
}

server {
    listen 80 default_server;
    server_name _;
    return 301 https://$host$request_uri;
}
