#!/usr/bin/env bash
# hvnb-update -- spielt ein Release-Paket des AU Storage Manager for Hyper-V
# auf diesem Server ein (Offline-Update, kein Internetzugang noetig).
#
#   hvnb-update <hvnb-X.Y.Z.tar.gz>     Paket pruefen, laden, umschalten
#   hvnb-update --status                laufende Version, vorherige Version, Sicherungen
#   hvnb-update --rollback [--with-db]  zurueck auf die vorherige Version
#                                       (--with-db: zusaetzlich die Datenbank von
#                                       vor dem letzten Update zurueckspielen)
#   hvnb-update --set-registry <pfad>   Online-Updates erlauben: Image-Pfad der
#                                       Registry hinterlegen, z.B.
#                                       ghcr.io/<konto>/hvnb-backup ("none" entfernt ihn)
#   hvnb-update --check-registry        neueste dort veroeffentlichte Version anzeigen
#   hvnb-update --from-registry [X.Y.Z] Version aus der Registry holen und
#                                       einspielen (ohne Angabe: die neueste)
#   hvnb-update --install-agent         Update-Dienst einrichten: danach kann ein
#                                       Paket in der GUI (Settings > Updates)
#                                       hochgeladen und eingespielt werden
#   hvnb-update --uninstall-agent       Update-Dienst wieder entfernen
#
# Optionen fuer das Einspielen:
#   --allow-unsigned   nur mit hinterlegtem Signaturschluessel von Bedeutung:
#                      ein Paket ohne Signaturdatei trotzdem zulassen
#   --force            auch einspielen, wenn noch Backups/Restores laufen
#
# Ablauf beim Einspielen:
#   1. Pruefsumme (<paket>.sha256) pruefen. Eine Signatur (<paket>.sig) wird
#      nur geprueft, wenn auf diesem Server ein oeffentlicher Schluessel liegt
#      (~/.config/hvnb/release-signing.pub bzw. HVNB_RELEASE_PUBKEY) -- ohne
#      Schluessel gilt allein die Pruefsumme.
#   2. Abbrechen, wenn in der App noch ein Backup oder Restore laeuft.
#   3. Image laden, Datenbank im laufenden Betrieb konsistent sichern
#      (/data/update-backups im Daten-Volume, die letzten 5 bleiben).
#   4. Quadlet-Unit auf das neue Image umstellen und neu starten.
#   5. Auf den Health-Check warten. Antwortet die App nicht, wird automatisch
#      auf das vorherige Image zurueckgestellt (die Datenbank bleibt, wie sie
#      ist -- Rueckspielen bei Bedarf mit --rollback --with-db).
#
# Laeuft als der Linux-Benutzer, dem der rootless-Podman-Container gehoert
# (kein sudo). Die Daten-Volumes und die .env werden nie veraendert.
set -euo pipefail

UNIT="${HVNB_UNIT:-hvnb-backup}"
QUADLET="${HVNB_QUADLET:-${HOME}/.config/containers/systemd/${UNIT}.container}"
PUBKEY="${HVNB_RELEASE_PUBKEY:-${HOME}/.config/hvnb/release-signing.pub}"
STATE_DIR="${HVNB_STATE_DIR:-${HOME}/.config/hvnb}"
STATE_FILE="${STATE_DIR}/${UNIT}.update-state"
HEALTH_TIMEOUT="${HVNB_HEALTH_TIMEOUT:-180}"
KEEP_DB_BACKUPS=5

log() { echo "[hvnb-update] $*"; }
die() { echo "[hvnb-update] FEHLER: $*" >&2; exit 1; }
# Exit 3 = "jetzt nicht, spaeter erneut versuchen" (laufende Backups, anderes Update) --
# darauf verlaesst sich hvnb-git-autoupdate.
die_busy() { echo "[hvnb-update] FEHLER: $*" >&2; exit 3; }

take_lock() {
  mkdir -p "${STATE_DIR}"
  exec 9>"${STATE_DIR}/${UNIT}.update.lock"
  flock -n 9 || die_busy "Fuer ${UNIT} laeuft bereits ein Update oder Rollback."
}

quadlet_value() { sed -n "s/^$1=//p" "${QUADLET}" | head -n1; }

require_quadlet() {
  [ -f "${QUADLET}" ] || die "Quadlet-Unit ${QUADLET} nicht gefunden (siehe DEPLOYMENT.md Abschnitt 6)."
  CONTAINER="$(quadlet_value ContainerName)"
  [ -n "${CONTAINER}" ] || CONTAINER="systemd-${UNIT}"
  CURRENT_IMAGE="$(quadlet_value Image)"
  [ -n "${CURRENT_IMAGE}" ] || die "Keine Image=-Zeile in ${QUADLET}."
  # PublishPort=8443:443 bzw. 127.0.0.1:8443:443 -> Host-Port fuer den Health-Check
  HOST_PORT="$(quadlet_value PublishPort | awk -F: '{print $(NF-1)}')"
  [ -n "${HOST_PORT}" ] || HOST_PORT=8443
  DATA_VOLUME="$(sed -n 's/^Volume=\([^:]*\):\/data$/\1/p' "${QUADLET}" | head -n1)"
}

container_running() { podman container inspect -f '{{.State.Running}}' "${CONTAINER}" 2>/dev/null | grep -q true; }

app_version() {
  container_running || { echo "nicht gestartet"; return; }
  podman exec "${CONTAINER}" python3 -c \
    "import json;d=json.load(open('/opt/app/VERSION.json'));print(d.get('version','?'), '(Commit', d.get('commit','?')[:7]+')')" 2>/dev/null \
    || echo "ohne Versionsnummer (bisherige Auslieferung per git)"
}

wait_healthy() {
  local waited=0
  while [ "${waited}" -lt "${HEALTH_TIMEOUT}" ]; do
    if curl -sk --max-time 5 "https://127.0.0.1:${HOST_PORT}/api/health" 2>/dev/null | grep -q '"status":"ok"'; then
      return 0
    fi
    sleep 3
    waited=$((waited + 3))
  done
  return 1
}

set_image() {
  # Nur die Image=-Zeile aendern, alles andere in der Unit bleibt unberuehrt.
  sed -i "s|^Image=.*|Image=$1|" "${QUADLET}"
  systemctl --user daemon-reload
}

restart_unit() { systemctl --user restart "${UNIT}.service"; }

busy_runs() {
  # Anzahl noch laufender Backups/Restores laut App-Datenbank; leer, wenn nicht ermittelbar.
  podman exec -i "${CONTAINER}" python3 - <<'PY' 2>/dev/null || true
import sqlite3
con = sqlite3.connect("file:/data/app.db?mode=ro", uri=True, timeout=5)
total = 0
for table in ("backup_runs", "restore_runs"):
    try:
        total += con.execute(
            f"SELECT count(*) FROM {table} WHERE lower(status) IN ('running', 'pending', 'cleaning_up')"
        ).fetchone()[0]
    except sqlite3.Error:
        pass
print(total)
PY
}

backup_db() {
  # Online-Backup-API von SQLite: konsistent, auch waehrend die App laeuft.
  local name="vor-update-$(date +%Y%m%d-%H%M%S).sqlite"
  podman exec -i -e "HVNB_BACKUP_NAME=${name}" -e "HVNB_KEEP=${KEEP_DB_BACKUPS}" "${CONTAINER}" python3 - <<'PY'
import os, sqlite3
folder = "/data/update-backups"
os.makedirs(folder, exist_ok=True)
target = os.path.join(folder, os.environ["HVNB_BACKUP_NAME"])
src = sqlite3.connect("/data/app.db", timeout=30)
dst = sqlite3.connect(target)
with dst:
    src.backup(dst)
dst.close(); src.close()
check = sqlite3.connect(target)
assert check.execute("PRAGMA integrity_check").fetchone()[0] == "ok", "Sicherung ist nicht integer"
check.close()
files = sorted(f for f in os.listdir(folder) if f.startswith("vor-update-") and f.endswith(".sqlite"))
for old in files[: -int(os.environ["HVNB_KEEP"])]:
    os.remove(os.path.join(folder, old))
PY
  # Nicht auf den Exit-Code allein verlassen: die Datei muss wirklich da sein.
  podman exec "${CONTAINER}" test -s "/data/update-backups/${name}"
  echo "${name}"
}

write_state() {
  mkdir -p "${STATE_DIR}"
  {
    echo "PREVIOUS_IMAGE=$1"
    echo "CURRENT_IMAGE=$2"
    echo "DB_BACKUP=$3"
    echo "UPDATED_AT=$(date -Iseconds)"
  } > "${STATE_FILE}"
}

state_value() { [ -f "${STATE_FILE}" ] && sed -n "s/^$1=//p" "${STATE_FILE}" | head -n1 || true; }

cmd_status() {
  require_quadlet
  log "Unit:              ${UNIT}.service ($(systemctl --user is-active "${UNIT}.service" 2>/dev/null || true))"
  log "Image:             ${CURRENT_IMAGE}"
  log "Version:           $(app_version)"
  log "Vorheriges Image:  $(state_value PREVIOUS_IMAGE || true)"
  log "Letztes Update:    $(state_value UPDATED_AT || true)"
  if container_running; then
    log "DB-Sicherungen vor Updates (im Volume ${DATA_VOLUME:-?} unter /data/update-backups):"
    podman exec "${CONTAINER}" sh -c 'ls -1 /data/update-backups 2>/dev/null' | sed 's/^/[hvnb-update]   /' || true
  fi
  if systemctl --user is-active "${UNIT}-update-agent.timer" >/dev/null 2>&1; then
    log "Update-Dienst:     aktiv (Upload in der GUI moeglich)"
  else
    log "Update-Dienst:     nicht eingerichtet (hvnb-update --install-agent)"
  fi
  local registry
  registry="$(registry_repo)"
  log "Online-Registry:   ${registry:-keine (nur Paketdateien)}"
  if [ -f "${PUBKEY}" ]; then log "Signaturpruefung:  an (${PUBKEY})"; else log "Signaturpruefung:  aus (kein Schluessel hinterlegt, nur Pruefsumme)"; fi
}

verify_package() {
  local package="$1" allow_unsigned="$2"
  [ -f "${package}" ] || die "Paketdatei ${package} nicht gefunden."
  [ -f "${package}.sha256" ] || die "Pruefsummendatei ${package}.sha256 fehlt -- sie gehoert zum Paket."
  local expected actual
  expected="$(awk '{print $1}' "${package}.sha256" | head -n1)"
  actual="$(sha256sum "${package}" | awk '{print $1}')"
  [ "${expected}" = "${actual}" ] || die "Pruefsumme stimmt nicht (Datei beschaedigt oder veraendert)."
  log "Pruefsumme in Ordnung."

  # Signatur ist optional (Nutzer-Entscheidung 2026-10-08: Betrieb ohne
  # Schluessel). Erst wenn auf diesem Server ein oeffentlicher Schluessel
  # hinterlegt ist, wird sie verlangt -- dann aber zwingend.
  if [ ! -f "${PUBKEY}" ]; then
    log "Keine Signaturpruefung (auf diesem Server ist kein Signaturschluessel hinterlegt)."
  elif [ -f "${package}.sig" ]; then
    openssl dgst -sha256 -verify "${PUBKEY}" -signature "${package}.sig" "${package}" >/dev/null 2>&1 \
      || die "Signatur ist UNGUELTIG -- das Paket stammt nicht vom Inhaber des Signaturschluessels. Nicht einspielen."
    log "Signatur in Ordnung."
  elif [ "${allow_unsigned}" = "1" ]; then
    log "WARNUNG: Signatur nicht geprueft (--allow-unsigned)."
  else
    die "Auf diesem Server ist ein Signaturschluessel hinterlegt, aber ${package}.sig fehlt. Bewusst unsigniert einspielen nur mit --allow-unsigned."
  fi
}

check_busy() {
  local force="$1"
  if container_running; then
    local busy
    busy="$(busy_runs)"
    if [ "${force}" != "1" ]; then
      [[ "${busy}" =~ ^[0-9]+$ ]] || die "Konnte nicht pruefen, ob noch Backups/Restores laufen. In der App nachsehen und dann bewusst --force angeben."
      [ "${busy}" = "0" ] || die_busy "In der App laufen noch ${busy} Backup-/Restore-Vorgaenge. Abwarten oder bewusst --force angeben."
    fi
  else
    log "Hinweis: Container laeuft nicht -- keine Pruefung auf laufende Vorgaenge, keine DB-Sicherung im Betrieb."
  fi
}

cmd_install() {
  local package="$1" allow_unsigned="$2" force="$3"
  require_quadlet
  take_lock
  verify_package "${package}" "${allow_unsigned}"
  check_busy "${force}"

  log "Lade Image aus ${package} ..."
  local loaded new_image
  loaded="$(podman load -i "${package}" 2>&1)" || die "podman load fehlgeschlagen: ${loaded}"
  new_image="$(printf '%s\n' "${loaded}" | sed -n 's/^Loaded image[s]*: //p' | tail -n1)"
  [ -n "${new_image}" ] || die "Konnte den Namen des geladenen Images nicht ermitteln: ${loaded}"
  log "Geladen: ${new_image}"
  activate_image "${new_image}"
}

# Stellt die Unit auf ein bereits lokal vorhandenes Image um: DB sichern,
# umschalten, Health-Check, sonst zurueck. Gemeinsamer Teil von Paket- und
# Registry-Update.
activate_image() {
  local new_image="$1"
  if [ "${new_image}" = "${CURRENT_IMAGE}" ]; then
    log "Dieses Image ist bereits eingestellt -- starte nur neu."
  fi

  local db_backup=""
  if container_running; then
    db_backup="$(backup_db)" || die "Datenbank-Sicherung fehlgeschlagen -- Update nicht ausgefuehrt."
    log "Datenbank gesichert: /data/update-backups/${db_backup}"
  fi

  local previous="${CURRENT_IMAGE}" old_state=""
  [ "${new_image}" = "${previous}" ] && previous="$(state_value PREVIOUS_IMAGE)"
  [ -f "${STATE_FILE}" ] && old_state="$(cat "${STATE_FILE}")"
  write_state "${previous}" "${new_image}" "${db_backup}"

  log "Stelle ${UNIT} auf ${new_image} um und starte neu ..."
  set_image "${new_image}"
  restart_unit || true

  if wait_healthy; then
    log "Fertig. Laufende Version: $(app_version)"
    return 0
  fi

  log "Die App antwortet nach ${HEALTH_TIMEOUT}s nicht -- stelle zurueck auf ${CURRENT_IMAGE}."
  journalctl --user -u "${UNIT}.service" -n 25 --no-pager 2>/dev/null | sed 's/^/[hvnb-update]   | /' || true
  set_image "${CURRENT_IMAGE}"
  # Das fehlgeschlagene Update soll --rollback/--status nicht verfaelschen.
  if [ -n "${old_state}" ]; then printf '%s\n' "${old_state}" > "${STATE_FILE}"; else : > "${STATE_FILE}"; fi
  restart_unit || true
  if wait_healthy; then
    die "Update fehlgeschlagen, vorherige Version laeuft wieder. Datenbank unveraendert gelassen; Stand vor dem Update: /data/update-backups/${db_backup}"
  fi
  die "Update fehlgeschlagen und auch die vorherige Version antwortet nicht. Pruefen: systemctl --user status ${UNIT}.service; podman logs ${CONTAINER}"
}

# ---------- Online-Update aus einer Registry ----------
#
# Optional je Server: "hvnb-update --set-registry ghcr.io/<konto>/hvnb-backup"
# hinterlegt, woher Images geholt werden duerfen. Die Registry-Anmeldung
# (podman login) ist Sache des Servers; die App bekommt nie Zugangsdaten.
# Eingestellt wird immer ein fester Versions-Tag, nie "latest".

REGISTRY_FILE="${STATE_DIR}/${UNIT}.registry"
registry_repo() { if [ -f "${REGISTRY_FILE}" ]; then head -n1 "${REGISTRY_FILE}"; fi; }
tls_flag() { if [ "${HVNB_REGISTRY_TLS_VERIFY:-true}" = "false" ]; then echo "--tls-verify=false"; fi; }

running_version() {
  container_running || return 0
  podman exec "${CONTAINER}" python3 -c "import json;print(json.load(open('/opt/app/VERSION.json')).get('version',''))" 2>/dev/null || true
}

# Hoechste veroeffentlichte Version (Tags der Form X.Y.Z), ohne ein Image zu laden.
registry_latest() {
  local repo="$1" tags
  # shellcheck disable=SC2046
  tags="$(podman search $(tls_flag) --list-tags --limit 1000 --format '{{.Tag}}' "${repo}" 2>/dev/null)" || return 1
  printf '%s\n' "${tags}" | { grep -E '^[0-9]+\.[0-9]+\.[0-9]+$' || true; } | sort -V | tail -n1
}

cmd_set_registry() {
  mkdir -p "${STATE_DIR}"
  if [ "$1" = "none" ]; then
    : > "${REGISTRY_FILE}"
    log "Registry entfernt -- Online-Updates sind abgeschaltet."
    return 0
  fi
  [[ "$1" =~ ^[a-z0-9.-]+(:[0-9]+)?(/[a-z0-9._-]+)+$ ]] || die "Erwartet wird ein Image-Pfad wie ghcr.io/<konto>/hvnb-backup (klein geschrieben, ohne Tag)."
  echo "$1" > "${REGISTRY_FILE}"
  log "Registry hinterlegt: $1"
  local latest=""
  if latest="$(registry_latest "$1")" && [ -n "${latest}" ]; then
    log "Erreichbar, neueste Version dort: ${latest}"
  else
    log "WARNUNG: Registry nicht lesbar oder noch keine Version veroeffentlicht. Bei privaten Images zuerst: podman login ${1%%/*}"
  fi
}

cmd_check_registry() {
  require_quadlet
  local repo latest
  repo="$(registry_repo)"
  [ -n "${repo}" ] || die "Keine Registry hinterlegt (hvnb-update --set-registry <image-pfad>)."
  latest="$(registry_latest "${repo}")" || die "Registry ${repo} nicht lesbar (Netz, Anmeldung per 'podman login')."
  [ -n "${latest}" ] || die "In ${repo} ist noch keine Version (Tag X.Y.Z) veroeffentlicht."
  log "Laeuft:   $(running_version)"
  log "Neueste:  ${latest} (${repo})"
}

cmd_from_registry() {
  local version="$1" force="$2"
  require_quadlet
  take_lock
  local repo
  repo="$(registry_repo)"
  [ -n "${repo}" ] || die "Keine Registry hinterlegt (hvnb-update --set-registry <image-pfad>)."
  if [ -z "${version}" ] || [ "${version}" = "latest" ]; then
    version="$(registry_latest "${repo}")" || die "Registry ${repo} nicht lesbar (Netz, Anmeldung per 'podman login')."
    [ -n "${version}" ] || die "In ${repo} ist noch keine Version (Tag X.Y.Z) veroeffentlicht."
  fi
  [[ "${version}" =~ ^[0-9]+\.[0-9]+\.[0-9]+([-.][0-9A-Za-z.]+)?$ ]] || die "Ungueltige Version ${version}."
  check_busy "${force}"
  log "Hole ${repo}:${version} ..."
  # shellcheck disable=SC2046
  podman pull -q $(tls_flag) "${repo}:${version}" >/dev/null || die "podman pull ${repo}:${version} fehlgeschlagen."
  activate_image "${repo}:${version}"
}

cmd_rollback() {
  local with_db="$1"
  require_quadlet
  take_lock
  local previous db_backup
  previous="$(state_value PREVIOUS_IMAGE)"
  db_backup="$(state_value DB_BACKUP)"
  [ -n "${previous}" ] || die "Keine vorherige Version bekannt (${STATE_FILE} fehlt oder ist leer)."
  podman image exists "${previous}" || die "Das vorherige Image ${previous} ist auf diesem Server nicht mehr vorhanden."

  if [ "${with_db}" = "1" ]; then
    [ -n "${db_backup}" ] || die "Zum letzten Update gibt es keine Datenbank-Sicherung."
    [ -n "${DATA_VOLUME}" ] || die "Daten-Volume nicht aus ${QUADLET} ermittelbar."
    local mount
    mount="$(podman volume inspect "${DATA_VOLUME}" --format '{{.Mountpoint}}')"
    log "Halte ${UNIT} an und spiele die Datenbank von vor dem Update zurueck (${db_backup}) ..."
    systemctl --user stop "${UNIT}.service"
    podman unshare sh -c '
      set -e
      cd "$1"
      test -f "update-backups/$2"
      cp -p app.db "update-backups/vor-rollback-$(date +%Y%m%d-%H%M%S).sqlite"
      cp "update-backups/$2" app.db.neu
      mv app.db.neu app.db
      for leftover in app.db-wal app.db-shm; do
        if [ -e "$leftover" ]; then mv "$leftover" "update-backups/$leftover.verworfen"; fi
      done
    ' sh "${mount}" "${db_backup}" || die "Zurueckspielen der Datenbank fehlgeschlagen -- Unit ist angehalten, bitte pruefen."
  fi

  log "Stelle ${UNIT} zurueck auf ${previous} ..."
  write_state "${CURRENT_IMAGE}" "${previous}" ""
  set_image "${previous}"
  restart_unit || true
  wait_healthy || die "Die vorherige Version antwortet nach ${HEALTH_TIMEOUT}s nicht. Pruefen: podman logs ${CONTAINER}"
  log "Fertig. Laufende Version: $(app_version)"
}

# ---------- Update-Dienst (Auftraege aus der GUI) ----------
#
# Die App kann sich nicht selbst gegen ein neues Image austauschen. Sie legt
# Paket und Auftrag in den Ordner update-inbox des Daten-Volumes (siehe
# backend/app/core/app_update.py); ein systemd-Timer ruft alle ~30 s
# "hvnb-update --agent-run" auf, das den Auftrag abholt und das Paket ganz
# normal einspielt. Der Dienst fuehrt nichts anderes aus als dieses Skript.

AGENT_NAME="${UNIT}-update-agent"
AGENT_BIN="${HOME}/.local/bin/hvnb-update"
SYSTEMD_USER_DIR="${HOME}/.config/systemd/user"

inbox_dir() {
  [ -n "${DATA_VOLUME}" ] || die "Daten-Volume nicht aus ${QUADLET} ermittelbar."
  local mount
  mount="$(podman volume inspect "${DATA_VOLUME}" --format '{{.Mountpoint}}' 2>/dev/null)" || return 1
  echo "${mount}/update-inbox"
}

# Legt den Uebergabe-Ordner an. Das Wurzelverzeichnis eines aelteren Daten-
# Volumes gehoert u.U. einem Container-Benutzer (das fruehere Image hat /data
# einem Benutzer 'hvnb' uebereignet) -- der Host-Benutzer darf dort dann nichts
# anlegen. 'podman unshare' arbeitet als root des Benutzer-Namensraums und darf
# es; der Ordner gehoert danach dem Host-Benutzer (= root im Container).
ensure_inbox() {
  [ -d "$1" ] && [ -w "$1" ] && return 0
  mkdir -p "$1" 2>/dev/null && return 0
  podman unshare mkdir -p "$1" && podman unshare chown 0:0 "$1" && [ -w "$1" ] \
    || die "Kann den Uebergabe-Ordner $1 nicht anlegen (Rechte im Daten-Volume pruefen)."
}

# Feld aus einer von der App geschriebenen JSON-Datei (ein Schluessel je Zeile).
json_field() { sed -n "s/^\"$2\": \"\(.*\)\",\{0,1\}$/\1/p" "$1" | head -n1; }

write_result() {
  # $1 Ordner, $2 Status, $3 Paket, $4 Version, $5 Start, $6 Ende
  printf '{\n"status": "%s",\n"package": "%s",\n"version": "%s",\n"started_at": "%s",\n"finished_at": %s\n}\n' \
    "$2" "$3" "$4" "$5" "$( [ -n "$6" ] && printf '"%s"' "$6" || printf 'null' )" > "$1/.result.json.tmp"
  mv "$1/.result.json.tmp" "$1/result.json"
}

cmd_agent_run() {
  require_quadlet
  local inbox
  inbox="$(inbox_dir)" || exit 0   # Volume gibt es noch nicht (vor dem ersten Start)
  [ -d "$(dirname "${inbox}")" ] || exit 0
  ensure_inbox "${inbox}"
  printf '{\n"seen_at": "%s",\n"unit": "%s",\n"registry": "%s"\n}\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "${UNIT}" "$(registry_repo)" \
    > "${inbox}/.agent.json.tmp"
  mv "${inbox}/.agent.json.tmp" "${inbox}/agent.json"

  if [ -f "${inbox}/request.processing" ]; then
    # Ein frueherer Lauf wurde mittendrin beendet (z.B. Server-Neustart).
    write_result "${inbox}" "failed" "$(json_field "${inbox}/request.processing" package)" \
      "$(json_field "${inbox}/request.processing" version)" "" "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
    echo "Das Einspielen wurde unterbrochen (Dienst oder Server neu gestartet). Stand pruefen: hvnb-update --status" > "${inbox}/result.log"
    rm -f "${inbox}/request.processing"
  fi
  if [ ! -f "${inbox}/request.json" ]; then
    registry_auto "${inbox}"
    exit 0
  fi

  mv "${inbox}/request.json" "${inbox}/request.processing"
  local action package sha version started rc=0
  action="$(json_field "${inbox}/request.processing" action)"
  package="$(json_field "${inbox}/request.processing" package)"
  sha="$(json_field "${inbox}/request.processing" sha256)"
  version="$(json_field "${inbox}/request.processing" version)"

  if [ "${action}" = "registry-check" ]; then
    registry_check_report "${inbox}"
    mv "${inbox}/request.processing" "${inbox}/request.done"
    exit 0
  fi

  started="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  write_result "${inbox}" "running" "${package}" "${version}" "${started}" ""
  : > "${inbox}/result.log"

  if [ "${action}" = "registry-install" ]; then
    package="$(registry_repo):${version}"
    log "Auftrag aus der GUI: Version ${version} aus der Registry"
    "$0" --from-registry "${version}" > "${inbox}/result.log" 2>&1 || rc=$?
    if [ "${rc}" = "0" ]; then registry_check_report "${inbox}"; fi
  elif ! [[ "${package}" =~ ^hvnb-[0-9A-Za-z.-]+\.tar\.gz$ ]] || ! [[ "${sha}" =~ ^[0-9a-f]{64}$ ]] || [ ! -f "${inbox}/${package}" ]; then
    echo "Ungueltiger Auftrag (Paketname, Pruefsumme oder Datei fehlt)." > "${inbox}/result.log"
    rc=1
  else
    log "Auftrag aus der GUI: ${package}"
    echo "${sha}  ${package}" > "${inbox}/${package}.sha256"
    "$0" "${inbox}/${package}" > "${inbox}/result.log" 2>&1 || rc=$?
  fi

  write_result "${inbox}" "$( [ "${rc}" = "0" ] && echo succeeded || echo failed )" "${package}" "${version}" "${started}" \
    "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  # Paket und Auftrag sind verbraucht -- das geladene Image liegt in podman. Nur
  # bei "spaeter erneut" (laufende Backups, Exit 3) bleibt ein hochgeladenes
  # Paket zum erneuten Einspielen liegen.
  if [ "${rc}" != "3" ] && [[ "${package}" =~ ^hvnb-[0-9A-Za-z.-]+\.tar\.gz$ ]]; then
    rm -f "${inbox:?}/${package:?}" "${inbox:?}/${package:?}.sha256" "${inbox:?}/staged.json"
  fi
  rm -f "${inbox:?}/request.processing"
  log "Auftrag beendet (Exit ${rc})."
}

# Schreibt registry.json fuer die App: hinterlegte Registry, neueste Version, Zeitpunkt.
registry_check_report() {
  local inbox="$1" repo latest="" error=""
  repo="$(registry_repo)"
  if [ -z "${repo}" ]; then
    printf '{\n"repo": ""\n}\n' > "${inbox}/registry.json"
    return 0
  fi
  if ! latest="$(registry_latest "${repo}")"; then
    latest=""
    error="Registry nicht lesbar (Netz oder Anmeldung per podman login)."
  elif [ -z "${latest}" ]; then
    error="Noch keine Version veroeffentlicht."
  fi
  printf '{\n"repo": "%s",\n"latest_version": "%s",\n"checked_at": "%s",\n"error": "%s"\n}\n' \
    "${repo}" "${latest}" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "${error}" > "${inbox}/.registry.json.tmp"
  mv "${inbox}/.registry.json.tmp" "${inbox}/registry.json"
}

# Automatisches Online-Update (Schalter in der GUI, Standard aus): hoechstens
# stuendlich pruefen und eine neuere Version einspielen.
registry_auto() {
  local inbox="$1" repo
  repo="$(registry_repo)"
  [ -n "${repo}" ] || return 0
  [ -f "${inbox}/settings.json" ] || return 0
  grep -q '^"registry_auto_update": "on"' "${inbox}/settings.json" || return 0
  local stamp="${STATE_DIR}/${UNIT}.registry-auto-check"
  if [ -f "${stamp}" ] && [ -n "$(find "${stamp}" -mmin -60 2>/dev/null)" ]; then return 0; fi
  touch "${stamp}"
  registry_check_report "${inbox}"
  local latest current
  latest="$(json_field "${inbox}/registry.json" latest_version)"
  current="$(running_version)"
  [ -n "${latest}" ] && [ -n "${current}" ] || return 0
  [ "${latest}" != "${current}" ] || return 0
  # Nur vorwaerts: die Registry-Version muss die hoehere von beiden sein.
  [ "$(printf '%s\n%s\n' "${current%%-*}" "${latest}" | sort -V | tail -n1)" = "${latest}" ] || return 0
  log "Automatisches Online-Update: ${current} -> ${latest}"
  local started rc=0
  started="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  write_result "${inbox}" "running" "${repo}:${latest}" "${latest}" "${started}" ""
  "$0" --from-registry "${latest}" > "${inbox}/result.log" 2>&1 || rc=$?
  if [ "${rc}" = "3" ]; then
    # Backups laufen: beim naechsten Durchlauf erneut versuchen, nicht erst in einer Stunde.
    touch -d '2 hours ago' "${stamp}"
    write_result "${inbox}" "failed" "${repo}:${latest}" "${latest}" "${started}" "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
    return 0
  fi
  write_result "${inbox}" "$( [ "${rc}" = "0" ] && echo succeeded || echo failed )" "${repo}:${latest}" "${latest}" "${started}" \
    "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
}

cmd_install_agent() {
  require_quadlet
  mkdir -p "$(dirname "${AGENT_BIN}")" "${SYSTEMD_USER_DIR}"
  # Eigene Kopie: der Dienst soll nicht von einem Repository- oder Download-Ordner abhaengen.
  if [ "$(readlink -f "$0")" != "$(readlink -f "${AGENT_BIN}")" ]; then
    install -m 0755 "$0" "${AGENT_BIN}"
  fi
  cat > "${SYSTEMD_USER_DIR}/${AGENT_NAME}.service" <<UNIT_EOF
[Unit]
Description=AU Storage Manager - Update-Auftraege aus der GUI einspielen (${UNIT})

[Service]
Type=oneshot
Environment=HVNB_UNIT=${UNIT}
Environment=HVNB_QUADLET=${QUADLET}
Environment=HVNB_RELEASE_PUBKEY=${PUBKEY}
Environment=HVNB_STATE_DIR=${STATE_DIR}
ExecStart=${AGENT_BIN} --agent-run
TimeoutStartSec=3600
# Der Timer laeuft alle 30 s -- Start/Ende nicht jedes Mal ins Journal schreiben.
LogLevelMax=notice
UNIT_EOF
  cat > "${SYSTEMD_USER_DIR}/${AGENT_NAME}.timer" <<UNIT_EOF
[Unit]
Description=AU Storage Manager - Update-Auftraege pruefen (${UNIT})

[Timer]
OnBootSec=45s
OnUnitInactiveSec=30s
AccuracySec=5s

[Install]
WantedBy=timers.target
UNIT_EOF
  systemctl --user daemon-reload
  systemctl --user enable --now "${AGENT_NAME}.timer" >/dev/null
  systemctl --user start "${AGENT_NAME}.service" || true
  log "Update-Dienst eingerichtet (${AGENT_NAME}.timer, Skript: ${AGENT_BIN})."
  log "In der GUI unter Settings > Updates sollte der Dienst innerhalb einer Minute als aktiv erscheinen."
}

cmd_uninstall_agent() {
  systemctl --user disable --now "${AGENT_NAME}.timer" >/dev/null 2>&1 || true
  rm -f "${SYSTEMD_USER_DIR}/${AGENT_NAME}.timer" "${SYSTEMD_USER_DIR}/${AGENT_NAME}.service"
  systemctl --user daemon-reload
  log "Update-Dienst entfernt. Updates sind nur noch per 'hvnb-update <Paket>' auf dem Server moeglich."
}

PACKAGE="" ALLOW_UNSIGNED=0 FORCE=0 MODE="install" WITH_DB=0 VALUE=""
while [ "$#" -gt 0 ]; do
  case "$1" in
    --status) MODE="status" ;;
    --rollback) MODE="rollback" ;;
    --agent-run) MODE="agent-run" ;;
    --install-agent) MODE="install-agent" ;;
    --uninstall-agent) MODE="uninstall-agent" ;;
    --check-registry) MODE="check-registry" ;;
    --set-registry)
      MODE="set-registry"; VALUE="${2:-}"
      [ -n "${VALUE}" ] || die "--set-registry braucht einen Image-Pfad oder 'none'."
      shift
      ;;
    --from-registry)
      MODE="from-registry"
      if [ -n "${2:-}" ] && [[ "${2}" != --* ]]; then VALUE="$2"; shift; fi
      ;;
    --with-db) WITH_DB=1 ;;
    --allow-unsigned) ALLOW_UNSIGNED=1 ;;
    --force) FORCE=1 ;;
    -h|--help) sed -n '2,40p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    -*) die "Unbekannte Option $1 (siehe --help)." ;;
    *) PACKAGE="$1" ;;
  esac
  shift
done

for tool in podman systemctl curl openssl sha256sum flock; do
  command -v "${tool}" >/dev/null || die "Benoetigtes Programm fehlt: ${tool}"
done

case "${MODE}" in
  status) cmd_status ;;
  rollback) cmd_rollback "${WITH_DB}" ;;
  agent-run) cmd_agent_run ;;
  install-agent) cmd_install_agent ;;
  uninstall-agent) cmd_uninstall_agent ;;
  set-registry) cmd_set_registry "${VALUE}" ;;
  check-registry) cmd_check_registry ;;
  from-registry) cmd_from_registry "${VALUE}" "${FORCE}" ;;
  install)
    [ -n "${PACKAGE}" ] || { sed -n '2,40p' "$0" | sed 's/^# \{0,1\}//'; exit 2; }
    cmd_install "${PACKAGE}" "${ALLOW_UNSIGNED}" "${FORCE}"
    ;;
esac
