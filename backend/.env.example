# Kopieren nach .env und anpassen. Alle Variablen mit Prefix HVNB_.

HVNB_ENVIRONMENT=development
HVNB_SECRET_KEY=change-me-to-a-random-secret
HVNB_DATABASE_URL=sqlite:///./data/app.db

# Initialer lokaler Admin (nur beim allerersten Start relevant)
HVNB_INITIAL_ADMIN_PASSWORD=ChangeMe123!

# Active Directory
HVNB_AD_ENABLED=false
HVNB_AD_SERVER=dc01.example.local
HVNB_AD_DOMAIN=EXAMPLE
HVNB_AD_BASE_DN=DC=example,DC=local
HVNB_AD_USE_SSL=true

# NetApp ONTAP (9.18.1, MetroCluster)
HVNB_ONTAP_CLUSTER_MGMT_LIF=ontap-cluster.example.local
HVNB_ONTAP_USERNAME=api-svc
HVNB_ONTAP_PASSWORD=change-me
HVNB_ONTAP_VERIFY_SSL=true
HVNB_ONTAP_IS_METROCLUSTER=true

# Hyper-V / WinRM (Windows Server 2022 Hosts)
HVNB_WINRM_TRANSPORT=credssp
HVNB_WINRM_USE_HTTPS=true
HVNB_WINRM_PORT=5986

# Restore-Proxy-Host (dedizierter Windows-Host mit nativem iSCSI-Initiator
# fuer den VHDX-Restore-Workflow) wird nicht mehr per .env konfiguriert,
# sondern in der GUI unter Restore > Setup > Restore-Infrastruktur
# einrichten (verschluesselt in der DB gespeichert).

# Periodischer Hintergrundabgleich (Cluster-Health-Check, volle Discovery,
# Snapshot-Abgleich gegen echte ONTAP-Snapshots, Retention-Cleanup 15min
# nach dem Snapshot-Abgleich -- siehe app/core/scheduler.py)
HVNB_HEALTHCHECK_INTERVAL_MINUTES=15
HVNB_DISCOVERY_INTERVAL_MINUTES=240
HVNB_SNAPSHOT_RECONCILE_HOUR=2
HVNB_SCHEDULE_TIMEZONE=Europe/Vienna
# Sicherheitsnetz: offene Datei-Restore-Sessions (VHDX auf dem Restore-
# Proxy-Host gemountet, siehe Restore-Wizard "Dateien wiederherstellen")
# werden nach dieser Zeit automatisch aufgeraeumt, falls vergessen.
HVNB_FILE_RESTORE_MAX_AGE_HOURS=24

# HTTPS fuer die GUI
HVNB_TLS_CERT_PATH=/etc/hvnb/certs/server.crt
HVNB_TLS_KEY_PATH=/etc/hvnb/certs/server.key

# Git-basiertes Deployment
HVNB_GIT_REPO_URL=
HVNB_GIT_BRANCH=main
HVNB_AUTO_UPDATE_ENABLED=false
HVNB_AUTO_UPDATE_INTERVAL_MINUTES=15
